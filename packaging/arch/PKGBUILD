# Maintainer: Joshua Cox <josh@webhosting.coop>
pkgname=clip
pkgver=1.2.0
pkgrel=1
pkgdesc="Fast, cross-platform CLI clipboard wrapper for Wayland, X11, and terminal environments"
arch=('any')
url="https://joshuacox.github.io/clip/"
license=('GPL3')
optdepends=(
    'wl-clipboard: Wayland clipboard support'
    'xclip: X11 clipboard support'
    'xsel: Alternative X11 clipboard support'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/joshuacox/clip/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 clip "$pkgdir/usr/bin/clip"
    install -Dm644 man/clip.1 "$pkgdir/usr/share/man/man1/clip.1"
    install -Dm644 completions/bash/clip "$pkgdir/usr/share/bash-completion/completions/clip"
    install -Dm644 completions/zsh/_clip "$pkgdir/usr/share/zsh/site-functions/_clip"
    install -Dm644 completions/fish/clip.fish "$pkgdir/usr/share/fish/vendor_completions.d/clip.fish"
}
