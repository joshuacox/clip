#compdef clip

_clip() {
    local context state line
    typeset -A opt_args

    _arguments \
        '(-p -o --paste)'{-p,-o,--paste}'[Paste data from clipboard to standard output]' \
        '(-c --clear)'{-c,--clear}'[Clear current clipboard contents]' \
        '(-n --trim)'{-n,--trim}'[Trim trailing newline from input before copying]' \
        '(-s --primary)'{-s,--primary}'[Use primary selection buffer instead of clipboard]' \
        '--osc52[Force OSC 52 ANSI escape sequence for remote terminals]' \
        '(-h --help)'{-h,--help}'[Display help message and exit]' \
        '(-v --version)'{-v,--version}'[Display version information and exit]' \
        '--[Treat subsequent arguments as files]' \
        '*:file:_files'
}

_clip "$@"
