#!/bin/sh
set -e

VERSION="1.2.0"
PASTE_MODE=0
CLEAR_MODE=0
TRIM_NEWLINE=0
FORCE_OSC52=0
SELECTION="clipboard"

# Allow invoking as 'paste' or 'clip-paste' via symlink
case "$(basename "$0")" in
  paste|clip-paste)
    PASTE_MODE=1
    ;;
esac

show_help() {
  cat <<'EOF'
Usage: clip [OPTIONS] [FILE...]
Copy data to the system clipboard from files or standard input, or paste from it.

Options:
  -p, -o, --paste    Paste data from clipboard to standard output
  -c, --clear        Clear current clipboard contents
  -n, --trim         Trim trailing newline from input before copying
  -s, --primary      Use primary selection buffer instead of clipboard (X11/Wayland/OSC52)
      --osc52        Force OSC 52 ANSI escape sequence (useful over SSH or in tmux)
  -h, --help         Display this help message and exit
  -v, --version      Display version information and exit
  --                 Treat subsequent arguments as files, not options

Examples:
  date -I | clip              # Copy command output to clipboard
  pwd | clip -n               # Copy current path without trailing newline
  clip -c                     # Clear clipboard buffer
  clip file.txt               # Copy contents of file.txt to clipboard
  clip file1.txt file2.txt    # Copy concatenated files to clipboard
  clip -p                     # Print clipboard content to stdout
  clip -p > backup.txt        # Paste clipboard content to a file
  echo "remote" | clip --osc52 # Copy over SSH using terminal OSC 52
EOF
}

show_version() {
  echo "clip version ${VERSION}"
}

detect_backend() {
  if [ "$FORCE_OSC52" -eq 1 ]; then
    BACKEND="osc52"
    return
  fi

  if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then
    BACKEND="wayland"
  elif [ -n "$DISPLAY" ] && command -v xclip >/dev/null 2>&1; then
    BACKEND="xclip"
  elif [ -n "$DISPLAY" ] && command -v xsel >/dev/null 2>&1; then
    BACKEND="xsel"
  elif command -v pbcopy >/dev/null 2>&1; then
    BACKEND="macos"
  elif command -v clip.exe >/dev/null 2>&1; then
    BACKEND="wsl"
  elif command -v wl-copy >/dev/null 2>&1; then
    BACKEND="wayland"
  elif command -v xclip >/dev/null 2>&1; then
    BACKEND="xclip"
  elif command -v xsel >/dev/null 2>&1; then
    BACKEND="xsel"
  elif command -v base64 >/dev/null 2>&1 || command -v openssl >/dev/null 2>&1; then
    # Headless / SSH / container fallback via OSC 52
    BACKEND="osc52"
  else
    echo "clip: no supported clipboard utility found (checked: wl-copy, xclip, xsel, pbcopy, clip.exe, osc52)" >&2
    exit 1
  fi
}

osc52_copy() {
  if command -v base64 >/dev/null 2>&1; then
    B64=$(base64 | tr -d '\r\n')
  elif command -v openssl >/dev/null 2>&1; then
    B64=$(openssl base64 | tr -d '\r\n')
  else
    echo "clip: base64 utility required for OSC 52 copy" >&2
    exit 1
  fi

  BUF="c"
  if [ "$SELECTION" = "primary" ]; then
    BUF="p"
  fi

  # Support tmux / screen passthrough
  if [ -n "$TMUX" ] || [ "${TERM#screen}" != "$TERM" ] || [ "${TERM#tmux}" != "$TERM" ]; then
    SEQ=$(printf "\033Ptmux;\033\033]52;%s;%s\a\033\\" "$BUF" "$B64")
  else
    SEQ=$(printf "\033]52;%s;%s\a" "$BUF" "$B64")
  fi

  if [ -c /dev/tty ] && ( : > /dev/tty ) 2>/dev/null; then
    printf "%s" "$SEQ" > /dev/tty
  else
    printf "%s" "$SEQ"
  fi
}

copy_stream() {
  case "$BACKEND" in
    wayland)
      if [ "$SELECTION" = "primary" ]; then
        wl-copy --primary
      else
        wl-copy
      fi
      ;;
    xclip)
      xclip -in -selection "$SELECTION"
      ;;
    xsel)
      if [ "$SELECTION" = "primary" ]; then
        xsel --primary --input
      else
        xsel --clipboard --input
      fi
      ;;
    macos)
      pbcopy
      ;;
    wsl)
      clip.exe
      ;;
    osc52)
      osc52_copy
      ;;
  esac
}

paste_stream() {
  case "$BACKEND" in
    wayland)
      if [ "$SELECTION" = "primary" ]; then
        wl-paste --primary
      else
        wl-paste
      fi
      ;;
    xclip)
      xclip -out -selection "$SELECTION"
      ;;
    xsel)
      if [ "$SELECTION" = "primary" ]; then
        xsel --primary --output
      else
        xsel --clipboard --output
      fi
      ;;
    macos)
      pbpaste
      ;;
    wsl)
      if command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -Command "Get-Clipboard"
      else
        echo "clip: pasting on WSL requires powershell.exe" >&2
        exit 1
      fi
      ;;
    osc52)
      echo "clip: pasting is not supported via OSC 52 (terminal read sequence is restricted for security)" >&2
      exit 1
      ;;
  esac
}

# Parse options
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    -p|-o|--paste)
      PASTE_MODE=1
      shift
      ;;
    -c|--clear)
      CLEAR_MODE=1
      shift
      ;;
    -n|--trim)
      TRIM_NEWLINE=1
      shift
      ;;
    -s|--primary)
      SELECTION="primary"
      shift
      ;;
    --osc52)
      FORCE_OSC52=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "clip: unknown option '$1'" >&2
      echo "Try 'clip --help' for more information." >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

detect_backend

# Handle Clear Mode
if [ "$CLEAR_MODE" -eq 1 ]; then
  printf "" | copy_stream
  exit 0
fi

# Handle Paste Mode
if [ "$PASTE_MODE" -eq 1 ]; then
  if [ $# -gt 0 ]; then
    echo "clip: cannot accept file arguments in paste mode" >&2
    exit 1
  fi
  paste_stream
  exit 0
fi

# Handle Copy Mode
trim_filter() {
  if [ "$TRIM_NEWLINE" -eq 1 ]; then
    awk 'NR > 1 { print prev } { prev = $0 } END { printf "%s", prev }'
  else
    cat
  fi
}

if [ $# -gt 0 ]; then
  for file in "$@"; do
    if [ ! -e "$file" ]; then
      echo "clip: cannot access '$file': No such file or directory" >&2
      exit 1
    elif [ -d "$file" ]; then
      echo "clip: '$file': Is a directory" >&2
      exit 1
    elif [ ! -r "$file" ]; then
      echo "clip: cannot read '$file': Permission denied" >&2
      exit 1
    fi
  done
  cat "$@" | trim_filter | copy_stream
elif [ ! -t 0 ]; then
  trim_filter | copy_stream
else
  echo "clip: no data provided (provide file arguments or pipe data)" >&2
  exit 1
fi
